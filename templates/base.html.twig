<!DOCTYPE html>
<html lang="en-GB">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{% endblock %} · Finance Forecaster</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,500;0,700;1,400&family=Cinzel:wght@500;700&display=swap">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2224%22 fill=%22%232f3b29%22/><text x=%2264%22 y=%2296%22 font-size=%2288%22 text-anchor=%22middle%22 fill=%22%23d4b06a%22>❦</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% set route = app.current_route %}
        {% if app.user %}
        <nav class="site-nav">
            <span class="brand" aria-hidden="true">❦</span>
            <a href="{{ path('forecast') }}" {{ route == 'forecast' ? 'aria-current="page"' }}>Forecast</a>
            <a href="{{ path('recurring_index') }}" {{ route starts with 'recurring_' ? 'aria-current="page"' }}>Recurring</a>
            <a href="{{ path('ad_hoc_index') }}" {{ route starts with 'ad_hoc_' ? 'aria-current="page"' }}>Ad-hoc</a>
            <a href="{{ path('balance_index') }}" {{ route starts with 'balance_' ? 'aria-current="page"' }}>Balances</a>
            <form method="post" action="{{ path('app_logout') }}" class="logout">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="link-button">Log out</button>
            </form>
        </nav>
        {% endif %}
        <main>
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
