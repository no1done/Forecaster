# Copy to .env next to compose.yaml on the NAS and fill in.
# Generate each secret with: openssl rand -hex 32
# (hex only: the password goes inside a URL, so avoid symbols)
APP_SECRET=
POSTGRES_PASSWORD=

# The address you'll open in the browser, e.g. http://my-nas:8080
DEFAULT_URI=http://localhost:8080
HTTP_PORT=8080
