# Copy to .env next to compose.yaml on the NAS and fill in.

# Two different random values that you make up now. Generate each with:
#   openssl rand -hex 32
# Use hex only: the password goes inside a URL, so avoid symbols.
#
# APP_SECRET signs logins and "remember me" cookies. Changing it later
# just logs everyone out.
APP_SECRET=
# Postgres creates its database with this password on the very first start,
# so set it before the first `docker compose up`. Changing it afterwards
# won't change the database's password.
POSTGRES_PASSWORD=

# The address you open in the browser: the NAS's Tailscale name plus the
# port, e.g. http://ds124:8080. Only used for links built outside a web
# request (console commands), so it's fine to leave it if unsure.
DEFAULT_URI=http://localhost:8080
HTTP_PORT=8080
